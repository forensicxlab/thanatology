{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "whiteboard", "fileviewer", "leechcore"],
  "permissions": [
    "core:default",
    "mcp-bridge:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    "macos-permissions:default",
    "pty:allow-spawn",
    "pty:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-close"
  ],
  "allow": [
    {
      "name": "binaries/bin-macos/LeechCore/pcileech-aarch64-apple-darwin",
      "sidecar": true,
      "args": [
        "--input",
        { "validator": ".+" },

        "--port",
        { "validator": "^[0-9]{1,5}$" },

        "--mode",
        { "validator": "^[A-Za-z0-9_-]+$" }
      ]
    }
  ]
}
