{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "agent-workspace",
  "description": "Least-privilege capability for dedicated Exhume Agent windows",
  "windows": ["agent-*"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
